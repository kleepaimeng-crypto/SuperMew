{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minimew.local/contracts/run_event_v1.json",
  "title": "MiniMew Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "run_id",
    "thread_id",
    "type",
    "timestamp",
    "data"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "run.created",
        "run.started",
        "message.delta",
        "message.completed",
        "run.completed",
        "run.failed",
        "run.cancel_requested",
        "run.cancelled"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "$defs": {
    "RunStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "MessageStatus": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "PROVIDER_ERROR",
        "PROVIDER_TIMEOUT",
        "PROVIDER_INVALID_RESPONSE",
        "EXECUTION_EXPIRED",
        "EXECUTOR_INTERRUPTED",
        "MODEL_SNAPSHOT_MISSING",
        "MODEL_SNAPSHOT_INVALID",
        "CONTEXT_INVALID",
        "EXECUTION_STORAGE_UNAVAILABLE",
        "TOOL_NOT_AVAILABLE",
        "TOOL_INVALID_ARGUMENTS",
        "TOOL_PERMISSION_DENIED",
        "TOOL_EXECUTION_FAILED",
        "TOOL_INVALID_RESULT",
        "AGENT_BUDGET_EXCEEDED",
        "AGENT_DEADLINE_EXCEEDED",
        "KNOWLEDGE_ENCODING_FAILED",
        "KNOWLEDGE_RETRIEVAL_FAILED",
        "KNOWLEDGE_SCOPE_INVALID",
        "KNOWLEDGE_RESULT_INVALID",
        "KNOWLEDGE_QUERY_TOO_LONG"
      ]
    },
    "RunCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assistant_message_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "assistant_message_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "RunStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "running"
        }
      }
    },
    "MessageDeltaData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "content"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "MessageCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "status",
        "content"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        }
      }
    },
    "RunCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        }
      }
    },
    "RunFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_code"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        }
      }
    },
    "RunCancelRequestedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancel_requested_at"
      ],
      "properties": {
        "cancel_requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RunCancelledData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "cancelled"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "run.created"
        },
        "data": {
          "$ref": "#/$defs/RunCreatedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.started"
        },
        "data": {
          "$ref": "#/$defs/RunStartedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.delta"
        },
        "data": {
          "$ref": "#/$defs/MessageDeltaData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.completed"
        },
        "data": {
          "$ref": "#/$defs/MessageCompletedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.completed"
        },
        "data": {
          "$ref": "#/$defs/RunCompletedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.failed"
        },
        "data": {
          "$ref": "#/$defs/RunFailedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.cancel_requested"
        },
        "data": {
          "$ref": "#/$defs/RunCancelRequestedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.cancelled"
        },
        "data": {
          "$ref": "#/$defs/RunCancelledData"
        }
      }
    }
  ]
}
