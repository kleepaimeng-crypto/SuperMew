{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minimew.local/contracts/run_event_v1.json",
  "title": "MiniMew Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "run_id",
    "thread_id",
    "type",
    "timestamp",
    "data"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "run.created",
        "run.started",
        "message.delta",
        "message.completed",
        "run.completed",
        "run.failed",
        "run.cancel_requested",
        "run.cancelled",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "hitl.required",
        "hitl.accepted",
        "run.resumed",
        "process.step",
        "process.detail"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "$defs": {
    "RunStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "waiting_input",
        "resume_pending"
      ]
    },
    "MessageStatus": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "cancelled",
        "waiting_input"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "PROVIDER_ERROR",
        "PROVIDER_TIMEOUT",
        "PROVIDER_INVALID_RESPONSE",
        "EXECUTION_EXPIRED",
        "EXECUTOR_INTERRUPTED",
        "MODEL_SNAPSHOT_MISSING",
        "MODEL_SNAPSHOT_INVALID",
        "CONTEXT_INVALID",
        "EXECUTION_STORAGE_UNAVAILABLE",
        "TOOL_NOT_AVAILABLE",
        "TOOL_INVALID_ARGUMENTS",
        "TOOL_PERMISSION_DENIED",
        "TOOL_EXECUTION_FAILED",
        "TOOL_INVALID_RESULT",
        "AGENT_BUDGET_EXCEEDED",
        "AGENT_DEADLINE_EXCEEDED",
        "KNOWLEDGE_ENCODING_FAILED",
        "KNOWLEDGE_RETRIEVAL_FAILED",
        "KNOWLEDGE_SCOPE_INVALID",
        "KNOWLEDGE_RESULT_INVALID",
        "KNOWLEDGE_QUERY_TOO_LONG",
        "HITL_EXPIRED",
        "HITL_CHECKPOINT_INVALID"
      ]
    },
    "RunCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assistant_message_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "assistant_message_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "RunStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "running"
        }
      }
    },
    "MessageDeltaData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "content"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "MessageCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "status",
        "content"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        }
      }
    },
    "RunCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "succeeded"
        }
      }
    },
    "RunFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_code"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        }
      }
    },
    "RunCancelRequestedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancel_requested_at"
      ],
      "properties": {
        "cancel_requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RunCancelledData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "cancelled"
        }
      }
    },
    "ToolStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_id",
        "tool_name"
      ],
      "properties": {
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      }
    },
    "ToolCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_id",
        "tool_name"
      ],
      "properties": {
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      }
    },
    "ToolFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_id",
        "tool_name",
        "error_code"
      ],
      "properties": {
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        }
      }
    },
    "HitlRequiredData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "prompt",
        "expires_at"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "HitlAcceptedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ProcessKind": {
      "type": "string",
      "enum": [
        "model",
        "retrieval",
        "dense",
        "bm25",
        "fusion",
        "merge",
        "rerank",
        "assessment",
        "rewrite",
        "plan",
        "subquestion"
      ]
    },
    "ProcessSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version_id",
        "title"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ProcessStepData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "parent_step_id",
        "tool_call_id",
        "kind",
        "status",
        "query",
        "summary",
        "count",
        "sources",
        "outcome",
        "elapsed_ms"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "parent_step_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{32})?$"
        },
        "tool_call_id": {
          "type": "string",
          "maxLength": 128
        },
        "kind": {
          "$ref": "#/$defs/ProcessKind"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 1024
        },
        "summary": {
          "type": "string",
          "maxLength": 1024
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "sources": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/ProcessSource"
          }
        },
        "outcome": {
          "type": "string",
          "maxLength": 64
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "ProcessSourceDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version_id",
        "name",
        "version_number",
        "sections"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "version_number": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "ProcessDetailData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "stage",
        "phase",
        "purpose",
        "attempt",
        "missing",
        "questions",
        "sources"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "stage": {
          "type": "string",
          "enum": [
            "start",
            "result"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "",
            "initial",
            "aggregate",
            "rewritten",
            "clarified",
            "child"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "",
            "model_decision",
            "tool_selection",
            "answer",
            "answer_repair"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "missing": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/ProcessSourceDetail"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "run.created"
        },
        "data": {
          "$ref": "#/$defs/RunCreatedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.started"
        },
        "data": {
          "$ref": "#/$defs/RunStartedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.delta"
        },
        "data": {
          "$ref": "#/$defs/MessageDeltaData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.completed"
        },
        "data": {
          "$ref": "#/$defs/MessageCompletedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.completed"
        },
        "data": {
          "$ref": "#/$defs/RunCompletedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.failed"
        },
        "data": {
          "$ref": "#/$defs/RunFailedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.cancel_requested"
        },
        "data": {
          "$ref": "#/$defs/RunCancelRequestedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.cancelled"
        },
        "data": {
          "$ref": "#/$defs/RunCancelledData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "tool.started"
        },
        "data": {
          "$ref": "#/$defs/ToolStartedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "tool.completed"
        },
        "data": {
          "$ref": "#/$defs/ToolCompletedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "tool.failed"
        },
        "data": {
          "$ref": "#/$defs/ToolFailedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "hitl.required"
        },
        "data": {
          "$ref": "#/$defs/HitlRequiredData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "hitl.accepted"
        },
        "data": {
          "$ref": "#/$defs/HitlAcceptedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.resumed"
        },
        "data": {
          "$ref": "#/$defs/RunStartedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "process.step"
        },
        "data": {
          "$ref": "#/$defs/ProcessStepData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "process.detail"
        },
        "data": {
          "$ref": "#/$defs/ProcessDetailData"
        }
      }
    }
  ]
}
