MINIMEW_APP_NAME=MiniMew
MINIMEW_ENVIRONMENT=development
MINIMEW_DIAGNOSTIC_LOG_DIR=.artifacts/logs
MINIMEW_DB_HOST=127.0.0.1
MINIMEW_DB_PORT=55432
MINIMEW_DB_NAME=minimew
MINIMEW_DB_USER=minimew
# 必须替换成本机随机密码；不要提交 .env。
MINIMEW_DB_PASSWORD=
MINIMEW_DB_TIMEOUT_SECONDS=3
# Redis 使用独立容器；请填独立随机密码，不复用数据库或 JWT Secret。
MINIMEW_REDIS_HOST=127.0.0.1
MINIMEW_REDIS_PORT=56379
MINIMEW_REDIS_PASSWORD=
MINIMEW_REDIS_KEY_PREFIX=minimew:run_events:v1
MINIMEW_REDIS_STREAM_MAXLEN=1000
MINIMEW_REDIS_STREAM_TTL_SECONDS=86400
MINIMEW_NOTIFICATION_SCAN_SECONDS=0.5
MINIMEW_EVENT_POLL_SECONDS=5
# 本机真实模型凭据；留空时账户/Thread 可用，新提问返回配置不可用。
MINIMEW_DEEPSEEK_API_KEY=
# 账户未选择个人模型时的服务端默认；Key沿用上项，仅用于此默认服务。
MINIMEW_DEFAULT_MODEL_ADAPTER=deepseek
MINIMEW_DEFAULT_MODEL_NAME=deepseek-flash
MINIMEW_DEFAULT_MODEL_BASE_URL=https://api.deepseek.com
MINIMEW_DEFAULT_MODEL_MAX_TOKENS=4096
MINIMEW_DEFAULT_MODEL_TIMEOUT=120
# 账户API Key的加密主密钥；不要使用JWT密钥，也不要提交真实值。
# 在MiniMew目录显式运行 python -m minimew.account_models init-key 初始化本机.env。
MINIMEW_CREDENTIAL_MASTER_KEY=
MINIMEW_EXECUTION_SCAN_SECONDS=0.5
# 每实例上限，同一个 Thread 仍按提问顺序执行。
MINIMEW_EXECUTION_MAX_ACTIVE=2
# Run 提交资格：默认每 5 秒续 20 秒；心跳须小于租期，不增加模型活动预算。
MINIMEW_EXECUTION_LEASE_SECONDS=20
MINIMEW_EXECUTION_HEARTBEAT_SECONDS=5
# 独立查询本 Run 的取消/资格状态，不等待模型下一批输出。
MINIMEW_CANCELLATION_POLL_SECONDS=0.5
# 必须填独立随机签名密钥（至少 32 字符），不要复用数据库密码。
MINIMEW_JWT_SECRET=
MINIMEW_ACCESS_TOKEN_MINUTES=15
MINIMEW_REFRESH_TOKEN_DAYS=7
# 本机 HTTP 开发用 false；production 配置必须为 true 并使用 HTTPS。
MINIMEW_REFRESH_COOKIE_SECURE=false

# 文档源文件目录；相对路径锚定 MiniMew 根目录，运行数据不进 Git。
MINIMEW_DOCUMENT_UPLOAD_DIR=data/documents
MINIMEW_DOCUMENT_MAX_UPLOAD_BYTES=5242880
# 仅用于首次创建个人知识库的目标配置；修改它不会重建或切换已有索引。
MINIMEW_EMBEDDING_PROFILE=bge-small-zh-v1.5
# 仅决定新知识库的构建布局；已有知识库通过显式 upgrade 创建新候选。
MINIMEW_DOCUMENT_INDEX_LAYOUT=hybrid-jieba-bm25-v1
# 运行参数不改变知识库目标/Job 快照；默认缓存不进入 Git。
MINIMEW_EMBEDDING_CACHE_DIR=data/models
MINIMEW_EMBEDDING_BATCH_SIZE=4
# 显式开启在线知识工具；true 时检查 Milvus 连接。
# false 保留普通聊天；true 缺资源时启动失败，不下载模型或静默隐藏工具。
MINIMEW_KNOWLEDGE_ENABLED=false
# 云端纯 API 部署设为 false：不加载本地 Embedding/Rerank，也不需要安装 --extra embedding。
# 本地开发默认 true；为 false 时新建项目和个人库均须配置云端百炼模型。
MINIMEW_LOCAL_MODELS_ENABLED=true

# 新 Run 默认冻结 v3 内部材料评判策略；false 仅让之后的新 Run 使用旧 v2。
# 已创建 Run 始终使用自身快照。不会启用知识工具、下载模型或改变历史 Run。
MINIMEW_REASONING_ENABLED=true
# 新Run默认v4：有限格式纠正和按问题保留代表材料；false使之后新Run冻结v3。
MINIMEW_REPAIRS_ENABLED=true
# 新Run默认v5：一次澄清/最多15分钟；需reasoning与repairs开启。false只影响之后的新Run。
MINIMEW_HITL_ENABLED=true

# 本机独立 Milvus；默认普通API不连接，开启知识工具后启动时只读检查连接。
MINIMEW_VECTOR_PORT=59530
MINIMEW_VECTOR_TIMEOUT_SECONDS=15
MINIMEW_VECTOR_BATCH_SIZE=4
# 默认本机开发容器未启用认证；连接已启用认证的服务时才填写，勿提交。
MINIMEW_VECTOR_TOKEN=

# 独立索引 Worker：一个在途构建，另有独立 DB 心跳；不随 API 自动启动。
MINIMEW_INDEX_POLL_SECONDS=1
MINIMEW_INDEX_LEASE_SECONDS=30
MINIMEW_INDEX_MAX_ATTEMPTS=5
MINIMEW_INDEX_JOB_TIMEOUT_SECONDS=600
