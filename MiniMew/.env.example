MINIMEW_APP_NAME=MiniMew
MINIMEW_ENVIRONMENT=development
MINIMEW_DB_HOST=127.0.0.1
MINIMEW_DB_PORT=55432
MINIMEW_DB_NAME=minimew
MINIMEW_DB_USER=minimew
# 必须替换成本机随机密码；不要提交 .env。
MINIMEW_DB_PASSWORD=
MINIMEW_DB_TIMEOUT_SECONDS=3
# Redis 使用独立容器；请填独立随机密码，不复用数据库或 JWT Secret。
MINIMEW_REDIS_HOST=127.0.0.1
MINIMEW_REDIS_PORT=56379
MINIMEW_REDIS_PASSWORD=
MINIMEW_REDIS_KEY_PREFIX=minimew:run_events:v1
MINIMEW_REDIS_STREAM_MAXLEN=1000
MINIMEW_REDIS_STREAM_TTL_SECONDS=86400
MINIMEW_NOTIFICATION_SCAN_SECONDS=0.5
MINIMEW_EVENT_POLL_SECONDS=5
# 本机真实模型凭据；留空时账户/Thread 可用，新提问返回配置不可用。
MINIMEW_DEEPSEEK_API_KEY=
MINIMEW_EXECUTION_SCAN_SECONDS=0.5
# 每实例上限，同一个 Thread 仍按提问顺序执行。
MINIMEW_EXECUTION_MAX_ACTIVE=2
# 独立查询本 Run 的取消/资格状态，不等待模型下一批输出。
MINIMEW_CANCELLATION_POLL_SECONDS=0.5
# 必须填独立随机签名密钥（至少 32 字符），不要复用数据库密码。
MINIMEW_JWT_SECRET=
MINIMEW_ACCESS_TOKEN_MINUTES=15
MINIMEW_REFRESH_TOKEN_DAYS=7
# 本机 HTTP 开发用 false；production 配置必须为 true 并使用 HTTPS。
MINIMEW_REFRESH_COOKIE_SECURE=false

# 文档源文件目录；相对路径锚定 MiniMew 根目录，运行数据不进 Git。
MINIMEW_DOCUMENT_UPLOAD_DIR=data/documents
MINIMEW_DOCUMENT_MAX_UPLOAD_BYTES=5242880
# 仅用于首次创建个人知识库的目标配置；修改它不会重建或切换已有索引。
MINIMEW_EMBEDDING_PROFILE=bge-small-zh-v1.5
# 运行参数不改变知识库目标/Job 快照；默认缓存不进入 Git。
MINIMEW_EMBEDDING_CACHE_DIR=data/models
MINIMEW_EMBEDDING_BATCH_SIZE=4

# 可选 vector profile；本机独立 Milvus，普通 API 启动不连接。
MINIMEW_VECTOR_PORT=59530
MINIMEW_VECTOR_TIMEOUT_SECONDS=15
MINIMEW_VECTOR_BATCH_SIZE=4
# 默认本机开发容器未启用认证；连接已启用认证的服务时才填写，勿提交。
MINIMEW_VECTOR_TOKEN=
